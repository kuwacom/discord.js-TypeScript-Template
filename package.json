{
  "name": "discord.js-typescript-template",
  "version": "5.1.0",
  "author": "kuwacom",
  "description": "",
  "main": "index.js",
  "scripts": {
    "wintest": "title %npm_config_id% && tsc && tsc-alias && node ./dist/index.js",
    "test": "tsc && tsc-alias && node ./dist/index.js",
    "dev": "tsc && tsc-alias && node ./dist/index.js --dev",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "winstart": "title %npm_config_id% && node ./dist/index.js",
    "start": "node ./dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "body-parser": "^1.20.4",
    "cors": "^2.8.6",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "opusscript": "^0.0.8",
    "tslog": "^4.10.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3"
  }
}
