{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": "./",
    "rootDir": "./src",
    "paths": {
      "@/*": ["./src/*"],
      "@configs/*": ["./src/configs/*"],
      "@app-types/*": ["./src/types/*"],
      "@models/*": ["./src/models/*"],
      "@utils/*": ["./src/utils/*"],
      "@commands/*": ["./src/commands/*"],
      "@buttons/*": ["./src/buttons/*"],
      "@modals/*": ["./src/modals/*"],
      "@selectMenus/*": ["./src/selectMenus/*"],
      "@format/*": ["./src/format/*"],
      "@routes/*": ["./src/routes/*"],
      "@middlewares/*": ["./src/middlewares/*"],
      "@services/*": ["./src/services/*"]
    },
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "tmp"]
}
